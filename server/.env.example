PORT=5000
MONGO_URI=mongodb://localhost:27017/eventsphere
JWT_SECRET=replace-with-a-long-random-secret
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_secret
RAZORPAY_WEBHOOK_SECRET=create-this-in-razorpay-dashboard
GROQ_API_KEY=optional
GROQ_MODEL=openai/gpt-oss-20b
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Or use one Cloudinary connection string instead of the three values above.
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
RESEND_API_KEY=optional
RESEND_FROM_EMAIL=events@yourdomain.com
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=optional
CLIENT_URL=http://localhost:3000